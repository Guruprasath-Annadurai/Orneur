# Orneur (formerly "Atheris") — Fly.io production image
# Slimmer than the dev Dockerfile: no build-essential, uses pre-built wheel.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# Install from the pre-built wheel (avoids re-compiling on every deploy).
# NOTE: this previously referenced "atheris_ai-*.whl", which never matched
# the actual built wheel name (the package is "orca-ai" per pyproject.toml
# -- `dist/orca_ai-*.whl` is what `python -m build` actually produces). That
# was a real, pre-existing bug: this build would fail today against any
# real dist/ directory. Fixed to reference the wheel that's actually built;
# not renamed to "orneur_ai" since the Python package name itself hasn't
# been migrated yet (see docs/orneur/phase-1/LEGACY_COMPATIBILITY.md).
COPY dist/orca_ai-*.whl /tmp/
RUN uv pip install --system "/tmp/orca_ai-$(ls /tmp/orca_ai-*.whl | head -1 | grep -oP '\d+\.\d+\.\d+').whl[docs]" \
    || uv pip install --system /tmp/orca_ai-*.whl

# Copy web assets and app code
COPY orca/ ./orca/

# /data is the Fly volume mount — all persistent state goes here
RUN mkdir -p /data
ENV ORNEUR_HOME=/data

EXPOSE 7337

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:7337/api/status || exit 1

# --no-open: don't try to launch a browser inside the container
CMD ["orca", "serve", "--host", "0.0.0.0", "--port", "7337", "--no-open"]
