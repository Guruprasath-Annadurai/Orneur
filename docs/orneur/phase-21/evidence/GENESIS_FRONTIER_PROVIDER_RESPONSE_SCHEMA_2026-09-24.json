    ],
    "raw_response_location": "<PATH_UNDER_EVIDENCE_ROOT>",
    "sha256": "<64_HEX>",
    "quoted_authoritative_clauses": [
      "<VERBATIM_CLAUSE>"
    ],
    "interpretation": "<REVIEWER_TEXT>",
    "remaining_ambiguity": [],
    "evidence_tier": "<A|B|C|D>",
    "review_status": "UNREVIEWED",
    "approved_state_changes": [],
    "reviewer": "<NAME>",
    "expiry_or_freshness": "<CONDITION>"
  },
  "provider_reference_binding": {
    "rule": "A response's provider must equal the canonical provider of its reference_name; a valid domain for a different provider never substitutes.",
    "canonical_map": {
      "DeepSeek V4.1-Flash": "DeepSeek AI",
      "GLM-5.3 (flagship)": "Zhipu AI / Z.ai",
      "Mistral Large 3": "Mistral AI",
      "MiniMax M3": "MiniMax",
      "Qwen3.8-Max": "Alibaba",
      "Kimi K3": "Moonshot AI"
