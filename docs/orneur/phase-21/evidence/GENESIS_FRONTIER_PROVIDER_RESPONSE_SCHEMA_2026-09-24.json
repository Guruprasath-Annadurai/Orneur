  "example_format": {
    "_SYNTHETIC_NON_EVIDENCE": true,
    "_warning": "PLACEHOLDER FORMAT ONLY. Not a provider reply. Never cite.",
    "provider": "<PROVIDER_ORGANIZATION>",
    "reference_name": "<LOCKED_REFERENCE_NAME>",
    "incoming_channel": "<CHANNEL>",
    "sender_identity": "<PLACEHOLDER>",
    "sender_domain": "<OFFICIAL_DOMAIN>",
