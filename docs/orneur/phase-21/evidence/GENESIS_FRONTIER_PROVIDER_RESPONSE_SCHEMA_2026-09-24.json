    "applies_to": [
      "provider responses",
      "account-setting evidence",
      "verified evidence refs",
      "execution evidence",
      "queue actions"
    ]
  },
  "attestation_limits": "Machine validation proves internal consistency and source persistence (hash of saved bytes, official-domain string, binding). It does NOT cryptographically prove a human has not fabricated metadata or file content. Human/connector provenance remains part of evidence review.",
  "resolution_assessment": {
    "purpose": "Separates ACTION LIFECYCLE COMPLETION (state=RESOLVED) from DEPENDENCY PREREQUISITE SATISFACTION. A provider may definitively answer NO: that is valid, conclusive evidence that may legitimately RESOLVE the upstream action, yet it must not unlock a conditional downstream action. Outcomes and facts control action sequencing ONLY.",
    "resolved_is_not_prerequisite_satisfied": true,
    "registry_dimensions_mutated": false,
    "registry_dimensions_still_changed_only_by": [
      "apply_verified_evidence",
      "resolve_blocker_token",
      "promote_access_status"
    ],
    "assessor_role": "EVIDENCE_REVIEWER",
    "outcomes": [
      "NOT_ASSESSED",
      "PREREQUISITE_SATISFIED",
      "PREREQUISITE_NOT_SATISFIED",
      "PARTIAL_INFORMATION",
      "NO_FOLLOWUP_REQUIRED"
    ],
    "only_outcome_that_unlocks_a_dependent": "PREREQUISITE_SATISFIED",
    "assessment_fields": [
      "action_id",
      "provider",
      "reference_name",
      "verified_evidence_ref",
      "outcome",
      "assessed_by_role",
      "assessed_at_utc",
      "assessment_source_ref",
      "assessment_sha256",
      "facts_established",
      "questions_addressed"
    ],
    "review_record": {
      "schema": "genesis-provider-resolution-review-v1",
      "rule": "assessment_source_ref points to a persisted review record under the evidence root whose canonical bytes (orca.eval.frontier_provider_resolution.review_record_bytes) must match the assessment exactly; assessment_sha256 is its SHA-256, recomputed at every dependency check."
    },
    "machine_validation_proves": [
      "exact action/provider/reference binding",
      "binding to the action's own verified-evidence ref",
      "valid outcome enum, role and UTC timestamp",
      "only fact codes defined for that action, no contradictions",
      "provider question-family and fact-to-question coverage derived from the validated evidence record",
      "durable review record hash and byte-for-byte consistency"
    ],
    "machine_validation_does_not_prove": "That the EVIDENCE_REVIEWER read the provider's prose correctly. Human review supplies the semantic interpretation; this layer only makes it exact, bound, and tamper-evident.",
