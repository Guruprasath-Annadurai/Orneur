# ── ORNEUR Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in only the values you actually use.
# .env is gitignored — never commit secrets.

# ── Phase 14 deployment profile ──────────────────────────────────────────────
# SOVEREIGN is the zero-config/local default. DISTRIBUTED intentionally fails
# startup unless all required shared authority/state backends are configured.
ORNEUR_DEPLOYMENT_PROFILE=SOVEREIGN

# Required together when ORNEUR_DEPLOYMENT_PROFILE=DISTRIBUTED.
# Use PostgreSQL connection URIs. Do not commit real credentials.
# ORNEUR_DATABASE_URL=postgresql://user:password@host:5432/database
# ORNEUR_GODMODE_DATABASE_URL=postgresql://user:password@host:5432/database
# ORNEUR_SECURITY_ROOT_DATABASE_URL=postgresql://user:password@separate-host:5432/database

# Production signing/authentication secrets. Generate independent random values;
# never reuse a database password or one secret for multiple purposes.
# ORNEUR_AUDIT_KEY=<random-secret>
# ORNEUR_GODMODE_LEASE_SECRET=<different-random-secret>
# ORNEUR_AUTH_SECRET=<different-random-secret>

# Optional runtime locations/model endpoint.
# ORNEUR_HOME=/absolute/path/to/orneur/data
# ORNEUR_OLLAMA_HOST=http://localhost:11434

# ── Legacy ORCA compatibility variables ──────────────────────────────────────
# The project still accepts legacy ORCA_* names in compatibility paths during
# the controlled ORNEUR migration. Prefer ORNEUR_* for new deployment work.

# ── Data directory ────────────────────────────────────────────────────────────
# Leave commented out to use the default (~/.orca). If you do set this,
# note that it must be a value your shell/os.environ can resolve — Python's
# Path() does NOT expand "~" on its own; only an explicit absolute path or
# $HOME-based value is safe here (orca/config.py calls .expanduser() as a
# defensive fix, but don't rely on that — prefer an absolute path).
# ORCA_HOME=/absolute/path/to/your/orca/data

# ── License key signing secret ────────────────────────────────────────────────
# REQUIRED before generating or verifying license keys at scale.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ORCA_LICENSE_SECRET=change-me-before-distributing

# ── Stripe integration ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY powers POST /api/billing/checkout (creates the Checkout
# Session a logged-in web user is redirected to). Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET verifies webhook signatures. Dashboard → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...
# If unset, webhook requests are REJECTED (fail-closed) unless you explicitly
# set ORCA_ALLOW_UNSIGNED_WEBHOOKS=1 for local dev only. Never set that in production.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PRO_YEAR=price_...
STRIPE_PRICE_ENT=price_...
STRIPE_PRICE_ENT_YEAR=price_...
# Base URL used for Stripe Checkout success/cancel redirects — set to your
# real domain in production (e.g. https://app.yourdomain.com).
ORCA_PUBLIC_URL=http://localhost:7337

# ── Email delivery ────────────────────────────────────────────────────────────
# Used to email license keys to customers immediately after payment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM=Orca <no-reply@yourdomain.com>

# ── Ollama (optional legacy overrides) ───────────────────────────────────────
# ORCA_OLLAMA_HOST=http://localhost:11434
# ORCA_CORE_MODEL=orca
# ORCA_NANO_MODEL=orca-nano
# ORCA_ULTRA_MODEL=orca

# ── Nvidia Nemotron (optional distillation teacher only, not live chat) ───────
# Only needed if using orca/train/distill.py with a "nvidia/*" teacher model
# (e.g. nvidia/nemotron-3-ultra-550b-a55b). Get a key at build.nvidia.com.
# NVIDIA_API_KEY=nvapi-...
